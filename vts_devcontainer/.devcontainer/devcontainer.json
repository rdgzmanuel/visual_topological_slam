{
    "name": "ROS 2 Jazzy / Python 3.12",
    "dockerFile": "Dockerfile",
    "context": "..",
    "build": {
        "args": {
            "WORKSPACE": "${containerWorkspaceFolder}"
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/topo_sigma,type=bind",
    "workspaceFolder": "/workspaces/topo_sigma/vts_devcontainer",
    "remoteUser": "ros",
    "runArgs": [
        "--network=host",
        "--add-host=host.docker.internal:host-gateway",
        "--hostname=jazzy"
    ],
    "mounts": [
        "source=${localWorkspaceFolder}/../encoder,target=/workspace/encoder,type=bind"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "bash"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/usr/bin/python3"
            },
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker",
                "ms-vscode.cpptools",
                "ajshort.msg",
                "GitHub.copilot",
                "gruntfuggly.todo-tree",
                "mutantdino.resourcemonitor",
                "njpwerner.autodocstring",
                "smilerobotics.urdf",
                "twxs.cmake",
                "charliermarsh.ruff",
                "ms-iot.vscode-ros"
            ]
        }
    }
}
